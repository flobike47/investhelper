# Copie ce fichier en .env (jamais committé) et remplis les valeurs.
# Inscription gratuite :
#   - Finnhub     : https://finnhub.io/register        (quote, news, recos analystes)
#   - Twelve Data : https://twelvedata.com/register    (historique OHLC pour indicateurs)
#   - NewsAPI     : https://newsapi.org/register       (actualités monde / business)
#
# Pourquoi Twelve Data en plus de Finnhub : depuis 2024 Finnhub a passé
# l'endpoint /stock/candle en plan payant. Twelve Data fournit le même
# historique gratuitement (800 req/jour).
#
# ATTENTION : ces clés sont expédiées dans le bundle JS côté client.
# Usage strictement perso / local. Pour partager l'app publiquement,
# il FAUT déplacer les appels API derrière un backend proxy.

VITE_FINNHUB_API_KEY=
VITE_TWELVE_DATA_API_KEY=
VITE_NEWSAPI_API_KEY=
# Mistral (legacy, plus utilisé) : https://console.mistral.ai/
VITE_MISTRAL_API_KEY=
# Gemini : analyse sémantique des news + génération du script podcast.
# Clé gratuite (1500 req/jour) : https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# FMP : recommandations analystes + price targets. Remplace les endpoints
# Finnhub passés en premium en 2024. https://site.financialmodelingprep.com/
VITE_FMP_API_KEY=
