# BFF runtime
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
# Adresse publique de l'app (lien des notifications push). Optionnelle :
# par défaut la première origine de CORS_ORIGIN, app servie à la racine.
APP_URL=

# Redis
REDIS_URL=redis://localhost:6379

# Supabase (https://supabase.com → Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # ⚠️ confidentiel, jamais côté frontend

# Providers — clés API
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
NEWSAPI_API_KEY=
FMP_API_KEY=
GEMINI_API_KEY=

# Notifications push (rappel quotidien du podcast) — optionnel.
# Sans ces trois variables, la fonctionnalité est désactivée.
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                              # ⚠️ confidentiel
VAPID_SUBJECT=mailto:toi@exemple.com
