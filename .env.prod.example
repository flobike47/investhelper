# À copier en .env.prod sur la Pi, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Images (par défaut : tags locaux. Mets le chemin de ton registry si push/pull)
BFF_IMAGE=investhelper-bff:latest
WEB_IMAGE=investhelper-web:latest

# Origin du frontend (CORS) — séparé par virgules si plusieurs
CORS_ORIGIN=https://tondomaine.com

# --- Conteneur web (runtime, injectés au boot) ---
# Sous-chemin où l'app est servie. "/" si à la racine du domaine, ou par ex.
# "/investhelper/" si servi via reverse proxy sur https://tondomaine.com/investhelper/
BASE_PATH=/
BFF_URL=https://api.tondomaine.com
SUPABASE_ANON_KEY=eyJ...        # clé Supabase publique (anon)
# (SUPABASE_URL ci-dessous est utilisé à la fois côté BFF et côté web)

# --- Conteneur BFF (Project Settings → API) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ... # ⚠️ secret, jamais côté web

# Providers
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
NEWSAPI_API_KEY=
FMP_API_KEY=
GEMINI_API_KEY=
